# Copy this file to .env and adjust if needed.

# Port of the local site: http://localhost:8080
WP_PORT=8080

# Optional: let the setup script try to download Divi for you (not verified, see README).
# Find both values in your Elegant Themes account (Account > Username & API Key).
# The reliable way is to save the theme as divi/Divi.zip yourself and leave these empty.
ET_USERNAME=
ET_API_KEY=
