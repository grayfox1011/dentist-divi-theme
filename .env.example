# Copy this file to .env and adjust if needed.

# Port of the local site: http://localhost:8080
WP_PORT=8080

# Optional: let the setup script download Divi for you.
# Find both values in your Elegant Themes account (Account > Username & API Key).
# Leave empty if you prefer to copy Divi.zip into the "divi" folder yourself.
ET_USERNAME=
ET_API_KEY=
