{
	"$schema": "https://schemas.wp.org/wp/6.6/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "760px",
			"wideSize": "1200px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"palette": [
				{ "slug": "primary", "name": "Primary", "color": "#1a66e8" },
				{ "slug": "primary-hover", "name": "Primary – Hover", "color": "#114db8" },
				{ "slug": "secondary", "name": "Secondary", "color": "#12b5a5" },
				{ "slug": "heading", "name": "Heading", "color": "#0b1b3f" },
				{ "slug": "body", "name": "Body Text", "color": "#4b5a75" },
				{ "slug": "dark", "name": "Dark Background", "color": "#081632" },
				{ "slug": "tint", "name": "Soft Blue Background", "color": "#edf4ff" },
				{ "slug": "mist", "name": "Light Background", "color": "#f6f9fe" },
				{ "slug": "line", "name": "Borders", "color": "#dce6f4" },
				{ "slug": "white", "name": "White", "color": "#ffffff" },
				{ "slug": "star", "name": "Rating Stars", "color": "#ffb020" }
			]
		},
		"typography": {
			"fluid": false,
			"defaultFontSizes": false,
			"fontFamilies": [
				{
					"slug": "heading",
					"name": "Plus Jakarta Sans",
					"fontFamily": "\"Plus Jakarta Sans\", system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Plus Jakarta Sans",
							"fontStyle": "normal",
							"fontWeight": "200 800",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/plus-jakarta-sans-latin-wght-normal.woff2" ],
							"unicodeRange": "U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD"
						},
						{
							"fontFamily": "Plus Jakarta Sans",
							"fontStyle": "normal",
							"fontWeight": "200 800",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/plus-jakarta-sans-latin-ext-wght-normal.woff2" ],
							"unicodeRange": "U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF"
						}
					]
				},
				{
					"slug": "body",
					"name": "Inter",
					"fontFamily": "Inter, system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Inter",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/inter-latin-wght-normal.woff2" ],
							"unicodeRange": "U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD"
						},
						{
							"fontFamily": "Inter",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/inter-latin-ext-wght-normal.woff2" ],
							"unicodeRange": "U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF"
						}
					]
				}
			],
			"fontSizes": [
				{ "slug": "x-small", "name": "Extra Small", "size": "13px" },
				{ "slug": "small", "name": "Small", "size": "15px" },
				{ "slug": "medium", "name": "Medium", "size": "17px" },
				{ "slug": "large", "name": "Large", "size": "clamp(17px, 1.4vw, 20px)" },
				{ "slug": "x-large", "name": "Extra Large", "size": "clamp(20px, 1.7vw, 24px)" },
				{ "slug": "xx-large", "name": "Section Title", "size": "clamp(30px, 3.6vw, 46px)" },
				{ "slug": "huge", "name": "Page Title", "size": "clamp(34px, 4.6vw, 58px)" },
				{ "slug": "display", "name": "Display", "size": "clamp(40px, 5.4vw, 68px)" }
			]
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"units": [ "px", "em", "rem", "%", "vw", "vh" ],
			"spacingSizes": [
				{ "slug": "20", "name": "Tiny", "size": "8px" },
				{ "slug": "30", "name": "Extra Small", "size": "12px" },
				{ "slug": "40", "name": "Small", "size": "16px" },
				{ "slug": "50", "name": "Medium", "size": "clamp(20px, 2.4vw, 32px)" },
				{ "slug": "60", "name": "Card Padding", "size": "clamp(24px, 2.6vw, 36px)" },
				{ "slug": "70", "name": "Large", "size": "clamp(32px, 4vw, 56px)" },
				{ "slug": "80", "name": "Extra Large", "size": "clamp(40px, 5vw, 80px)" },
				{ "slug": "90", "name": "Section", "size": "clamp(64px, 8vw, 120px)" }
			]
		},
		"shadow": {
			"defaultPresets": false,
			"presets": [
				{ "slug": "soft", "name": "Soft", "shadow": "0 18px 48px -18px rgba(11, 27, 63, 0.18)" },
				{ "slug": "lift", "name": "Lift", "shadow": "0 28px 64px -24px rgba(11, 27, 63, 0.28)" }
			]
		},
		"custom": {
			"radius": {
				"small": "12px",
				"medium": "20px",
				"large": "28px",
				"pill": "999px"
			}
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--white)",
			"text": "var(--wp--preset--color--body)"
		},
		"spacing": {
			"blockGap": "20px",
			"padding": {
				"top": "0px",
				"right": "clamp(20px, 5vw, 72px)",
				"bottom": "0px",
				"left": "clamp(20px, 5vw, 72px)"
			}
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.7"
		},
		"elements": {
			"heading": {
				"color": { "text": "var(--wp--preset--color--heading)" },
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontWeight": "700",
					"lineHeight": "1.15",
					"letterSpacing": "-0.02em"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--huge)",
					"fontWeight": "800",
					"lineHeight": "1.06",
					"letterSpacing": "-0.03em"
				}
			},
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)" } },
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)",
					"lineHeight": "1.25",
					"letterSpacing": "-0.01em"
				}
			},
			"h4": { "typography": { "fontSize": "19px", "lineHeight": "1.3", "letterSpacing": "-0.01em" } },
			"h5": { "typography": { "fontSize": "17px", "lineHeight": "1.4", "letterSpacing": "0" } },
			"h6": { "typography": { "fontSize": "15px", "lineHeight": "1.4", "letterSpacing": "0" } },
			"link": {
				"color": { "text": "var(--wp--preset--color--primary)" },
				":hover": { "color": { "text": "var(--wp--preset--color--primary-hover)" } }
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "var(--wp--preset--color--white)"
				},
				"border": {
					"radius": "var(--wp--custom--radius--pill)",
					"width": "1.5px",
					"style": "solid",
					"color": "var(--wp--preset--color--primary)"
				},
				"spacing": {
					"padding": { "top": "15px", "right": "28px", "bottom": "15px", "left": "28px" }
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontSize": "16px",
					"fontWeight": "600",
					"lineHeight": "1.2"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--primary-hover)",
						"text": "var(--wp--preset--color--white)"
					},
					"border": { "color": "var(--wp--preset--color--primary-hover)" }
				},
				":focus": {
					"color": {
						"background": "var(--wp--preset--color--primary-hover)",
						"text": "var(--wp--preset--color--white)"
					}
				}
			},
			"caption": {
				"color": { "text": "var(--wp--preset--color--body)" },
				"typography": { "fontSize": "var(--wp--preset--font-size--small)" }
			}
		},
		"blocks": {
			"core/button": {
				"variations": {
					"outline": {
						"color": {
							"background": "transparent",
							"text": "var(--wp--preset--color--heading)"
						},
						"border": {
							"color": "var(--wp--preset--color--line)",
							"width": "1.5px",
							"style": "solid"
						},
						"spacing": {
							"padding": { "top": "15px", "right": "28px", "bottom": "15px", "left": "28px" }
						}
					}
				}
			},
			"core/site-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontSize": "20px",
					"fontWeight": "800",
					"lineHeight": "1.2",
					"letterSpacing": "-0.01em"
				},
				"elements": {
					"link": {
						"color": { "text": "var(--wp--preset--color--heading)" },
						"typography": { "textDecoration": "none" }
					}
				}
			},
			"core/navigation": {
				"typography": {
					"fontSize": "16px",
					"fontWeight": "500",
					"lineHeight": "1.4"
				},
				"elements": {
					"link": {
						"color": { "text": "var(--wp--preset--color--heading)" },
						"typography": { "textDecoration": "none" },
						":hover": { "color": { "text": "var(--wp--preset--color--primary)" } }
					}
				}
			},
			"core/post-title": {
				"elements": {
					"link": {
						"color": { "text": "var(--wp--preset--color--heading)" },
						"typography": { "textDecoration": "none" },
						":hover": { "color": { "text": "var(--wp--preset--color--primary)" } }
					}
				}
			},
			"core/post-date": {
				"typography": { "fontSize": "13px" },
				"elements": {
					"link": {
						"color": { "text": "var(--wp--preset--color--body)" },
						"typography": { "textDecoration": "none" }
					}
				}
			},
			"core/post-terms": {
				"typography": { "fontSize": "13px" },
				"elements": { "link": { "typography": { "textDecoration": "none" } } }
			},
			"core/post-excerpt": {
				"typography": { "fontSize": "var(--wp--preset--font-size--small)", "lineHeight": "1.6" }
			},
			"core/separator": {
				"color": { "text": "var(--wp--preset--color--line)" }
			},
			"core/quote": {
				"border": {
					"left": { "color": "var(--wp--preset--color--secondary)", "width": "3px", "style": "solid" }
				},
				"spacing": { "padding": { "left": "20px" } },
				"color": { "text": "var(--wp--preset--color--heading)" },
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontSize": "var(--wp--preset--font-size--large)",
					"fontWeight": "600",
					"lineHeight": "1.5"
				}
			},
			"core/code": {
				"color": { "background": "var(--wp--preset--color--mist)", "text": "var(--wp--preset--color--heading)" },
				"border": { "radius": "var(--wp--custom--radius--small)", "color": "var(--wp--preset--color--line)", "width": "1px", "style": "solid" },
				"spacing": { "padding": { "top": "18px", "right": "22px", "bottom": "18px", "left": "22px" } },
				"typography": { "fontSize": "15px" }
			},
			"core/image": {
				"border": { "radius": "var(--wp--custom--radius--large)" }
			},
			"core/post-featured-image": {
				"border": { "radius": "var(--wp--custom--radius--medium)" }
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	],
	"customTemplates": [
		{ "name": "page-no-title", "title": "Page without title", "postTypes": [ "page" ] }
	]
}
